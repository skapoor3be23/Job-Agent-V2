# Copy to .env for local runs. Never commit the real file.
# On Streamlit Cloud, set these under App settings -> Secrets instead.

GOOGLE_API_KEY=
TAVILY_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Pipeline selection ---
USE_NEW_PIPELINE=true
ALLOW_LEGACY_FALLBACK=true

# --- Per-run call budgets (graceful degradation when exceeded) ---
MAX_LLM_CALLS_PER_RUN=8
MAX_EMBEDDING_CALLS_PER_RUN=3
MAX_SEARCH_CALLS_PER_RUN=4

# --- Opportunity Discovery ---
DISCOVERY_ENABLED=true
DISCOVERY_MAX_JOBS=15
DISCOVERY_MAX_QUERIES=4
DISCOVERY_RESULTS_PER_QUERY=10
ADZUNA_COUNTRY=in

# --- Scoring weights (must sum to 1.0) ---
WEIGHT_SEMANTIC=0.45
WEIGHT_SKILL_COVERAGE=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_ROLE_RELEVANCE=0.15

# --- Misc ---
CACHE_ENABLED=true
COVER_NOTE_MIN_WORDS=120
COVER_NOTE_MAX_WORDS=180
LOG_LEVEL=INFO
